# Copy to .env and adjust. Every value has a default in src/config.py.

# --- MQTT ---
MQTT_BROKER=test.mosquitto.org
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=NihatBerkay/iot_project

# --- Local LLM (Ollama) ---
OLLAMA_MODEL=phi4-mini:3.8b
# OLLAMA_HOST=http://127.0.0.1:11434

# --- Sensing ---
PING_TARGET=8.8.8.8
DNS_TARGET=www.google.com
POLL_INTERVAL=2

# --- Processing thresholds ---
LATENCY_WARN_MS=150
DNS_WARN_MS=500
